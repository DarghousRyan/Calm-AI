# Supabase project settings. Never commit the real values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Supabase PostgreSQL transaction pooler URL.
DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:6543/postgres

# Optional: required only for legacy local-auth deployments.
CALM_AI_AUTH_SECRET=replace-with-a-long-random-value
